# Database Configuration
DATABASE_URL="file:./data/profile_dark.db"

# Supabase / PostgreSQL Credentials (Optional for cloud sync)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# AI Text Providers (OpenAI, Anthropic, Gemini, Groq)
TEXT_PROVIDER="gemini"
TEXT_MODEL="gemini-1.5-pro"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# AI Image Providers (FLUX, Midjourney/Replicate, Stability, Fal.ai, DALL-E)
IMAGE_PROVIDER_PRIMARY="fal"
IMAGE_MODEL_PRIMARY="flux-pro/v1.1-ultra"
IMAGE_PROVIDER_FALLBACK="replicate"
IMAGE_MODEL_FALLBACK="black-forest-labs/flux-1.1-pro"
FAL_KEY=""
REPLICATE_API_TOKEN=""
STABILITY_API_KEY=""

# AI Video Providers (Runway Gen-3, Luma Dream Machine, Kling, Pika, Haiper)
VIDEO_PROVIDER_PRIMARY="runway"
VIDEO_MODEL_PRIMARY="gen3a_turbo"
VIDEO_PROVIDER_FALLBACK="luma"
VIDEO_MODEL_FALLBACK="dream-machine-v1.5"
RUNWAY_API_KEY=""
LUMA_API_KEY=""
KLING_API_KEY=""

# AI Voice / TTS Providers (ElevenLabs, OpenAI, Cartesia)
VOICE_PROVIDER="elevenlabs"
VOICE_MODEL="eleven_multilingual_v2"
ELEVENLABS_API_KEY=""

# Vision Inspection Provider
VISION_PROVIDER="gemini"
VISION_MODEL="gemini-1.5-pro"

# Storage Provider (local, supabase, s3, r2)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="profile-dark-assets"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"

# App & Queue Config
APP_URL="http://localhost:3000"
NODE_ENV="development"
ADMIN_KEY="profile_dark_master_secret"
CRON_SECRET=""
SOCIAL_TOKEN_ENCRYPTION_KEY=""
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/social/oauth/meta/callback"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/social/oauth/tiktok/callback"
DEFAULT_TEAM_ID=""
# Segurança financeira: mantenha true para impedir qualquer provider pago.
FREE_ONLY_MODE="true"
